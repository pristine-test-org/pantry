<% content_for :title, "Suppliers" %>

<header class="page-header">
  <p class="eyebrow">Purveyors</p>
  <h1>Suppliers</h1>
  <p class="lead">Who delivers what, and how far ahead to call.</p>
</header>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Supplier</th>
        <th scope="col">Contact</th>
        <th scope="col">Delivers</th>
        <th scope="col" class="numeric">Lead time</th>
        <th scope="col" class="numeric">Items</th>
      </tr>
    </thead>
    <tbody>
      <% @suppliers.each do |supplier| %>
        <tr>
          <th scope="row"><%= link_to supplier.name, supplier %></th>
          <td><%= supplier.contact_name %></td>
          <td><%= supplier.delivery_days %></td>
          <td class="numeric"><%= pluralize(supplier.lead_time_days, "day") %></td>
          <td class="numeric"><%= supplier.items.size %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
